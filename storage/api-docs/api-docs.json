    "components": {
        "schemas": {
            "Employee": {
                "title": "Employee",
                "required": [
                    "name",
                    "email",
                    "phone"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Lujine"
                    },
                    "email": {
                        "type": "string",
                        "example": "lujine@gmail.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "+9626118158"
                    },
                    "position": {
                        "type": "string",
                        "example": "Developer"
                    },
                    "projects": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Project"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Project": {
                "title": "Project",
                "required": [
                    "employee_id",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "employee_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Mobile App Update"
                    },
                    "description": {
                        "type": "string",
                        "example": "Add new features"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ProjectWithEmployee": {
                "title": "Project with Employee Info",
                "required": [
                    "id",
                    "title",
                    "employee"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Mobile App Update"
                    },
                    "description": {
                        "type": "string",
                        "example": "Add new features"
                    },
                    "employee": {
                        "$ref": "#/components/schemas/Employee"
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "422": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "example": "The given data was invalid."
                                },
                                "errors": {
                                    "type": "object",
                                    "example": {
                                        "name": [
                                            "The name field is required."
                                        ],
                                        "email": [
                                            "The email must be a valid email address."
                                        ]
                                    }
                                }
                            },
                            "type": "object"
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
